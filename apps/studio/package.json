{
  "name": "@acid-test/studio",
  "version": "1.0.0",
  "description": "Zero-config local visual dashboard on localhost:4400 for acid-test",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/bin/server.js",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@acid-test/core": "workspace:*",
    "@acid-test/billing": "workspace:*",
    "@acid-test/db": "workspace:*",
    "@acid-test/auth": "workspace:*",
    "@acid-test/queue": "workspace:*",
    "@acid-test/webhook": "workspace:*",
    "@acid-test/ai": "workspace:*",
    "@acid-test/email": "workspace:*",
    "@acid-test/storage": "workspace:*",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "rimraf": "^6.0.1"
  }
}
