{
  "name": "@acid-test/cli",
  "version": "1.0.0",
  "description": "Universal CLI runner for acid-test adversarial reliability and chaos suite",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "acid-test": "./dist/bin/cli.mjs",
    "acidtest": "./dist/bin/cli.mjs",
    "agy-acid": "./dist/bin/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node ./dist/bin/cli.mjs",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@acid-test/ai": "workspace:*",
    "@acid-test/auth": "workspace:*",
    "@acid-test/billing": "workspace:*",
    "@acid-test/core": "workspace:*",
    "@acid-test/db": "workspace:*",
    "@acid-test/email": "workspace:*",
    "@acid-test/queue": "workspace:*",
    "@acid-test/storage": "workspace:*",
    "@acid-test/studio": "workspace:*",
    "@acid-test/webhook": "workspace:*",
    "@clack/prompts": "^1.7.0",
    "@opentui/core": "^0.5.9",
    "@opentui/react": "^0.5.9",
    "asciichart": "^1.5.25",
    "commander": "^13.1.0",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "picocolors": "^1.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/asciichart": "^1.5.8",
    "@types/node": "^22.13.9",
    "@types/react": "^19.2.18",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
